# Copy to .env.local in the repository root. Never commit real credentials.
# Public browser configuration: required. Use a publishable key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only provider keys. Never prefix these with NEXT_PUBLIC_.
# Missing keys leave provider-dependent features unavailable; Library tracking remains.
GOOGLE_BOOKS_API_KEY=
GEMINI_API_KEY=

# Set true only after verifying the Gemini key's project has no paid billing linked.
# New deployments default to no Gemini requests until that check is complete.
GEMINI_FREE_TIER_VERIFIED=false
# Emergency switch: false pauses Gemini without affecting Library tracking.
GEMINI_ENABLED=true

# Optional model overrides; only these two model IDs are accepted by the app.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
